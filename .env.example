# ---------------------------------------------------------------------------
# Memory Capture AI — environment variables
# Copy to `.env` for local dev. Never commit real secrets.
# Front-end (Vite) vars must be prefixed VITE_. Everything else is server-only
# (Azure Functions app settings) and must NEVER reach the browser bundle.
# ---------------------------------------------------------------------------

# --- Front-end (safe to expose) ---
# Persistence mode: "guest" (localStorage only, fully offline) or "swa" (profiles
# persist in Cosmos via /api, photos in Blob). Requires the server-only Cosmos +
# Blob connection strings below when set to "swa".
# NOTE: Runtime demo/production switching is now handled via the /admin screen
# (localStorage key 'mcap_mode'). VITE_AUTH_PROVIDER is retained for compatibility.
VITE_AUTH_PROVIDER=guest

# Interview engine: "azure" calls the /api Functions (Azure AI Foundry, with
# automatic offline fallback); "offline" forces the local static engine.
# Leave unset for offline; set to azure when the API + keys are configured.
VITE_AI_MODE=azure

# --- Azure AI Foundry / Azure OpenAI (server-only) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Azure AI Speech (server-only) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Azure OpenAI image generation (server-only) — watercolor memory illustrations ---
# gpt-image-1 is not available in every region. If it's not available in the same
# resource/region as AZURE_OPENAI_ENDPOINT above, point these at a second resource;
# otherwise leave empty and the main AZURE_OPENAI_* values are reused.
AZURE_OPENAI_IMAGE_ENDPOINT=
AZURE_OPENAI_IMAGE_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=

# --- Persistence (server-only) — Cosmos DB free tier (NoSQL/Core API) ---
COSMOS_CONNECTION_STRING=

# --- Blob storage for storyteller photos + generated illustrations (server-only) ---
BLOB_CONNECTION_STRING=

# --- Sign-up approval workflow (server-only) ---
# Google sign-in is gated: new users land in a "pending" state in Cosmos until an
# admin approves/rejects them via one-click links in an email (see api/src/lib/users.ts).
# ADMIN_APPROVE_SECRET signs those single-use approve/reject links (HMAC-SHA256).
ADMIN_APPROVE_SECRET=

# --- Anonymous session token (server-only) ---
# Guest/demo mode intentionally allows using the AI interview without signing in, so
# the AI + speech endpoints (interview/*, memories/illustrate, speech/token) can't be
# gated behind Google auth. Instead the client mints a short-lived token via
# POST /api/session/start and sends it back on every call — see api/src/lib/sessionToken.ts.
# Required for those endpoints to work at all; set to any random string (e.g.
# `openssl rand -hex 32`) and keep it out of source control.
SESSION_TOKEN_SECRET=
# Where the "new sign-up" notification is sent. This address is also auto-approved
# (treated as the app owner) so it never gets stuck behind its own approval gate.
NOTIFY_EMAIL=
# Public base URL of the deployed app, used to build links in emails (e.g. the
# approve/reject buttons and the "sign in" link in the approval email).
APP_URL=

# --- Azure Communication Services (server-only) — transactional email ---
# Sends the 3-email approval flow: admin notification, user "pending" confirmation,
# user "approved"/"rejected" outcome. Soft-fails (logs, never crashes the request)
# when unset or when the ACS Managed Domain's 10-sends/hour quota is hit.
ACS_CONNECTION_STRING=
NOTIFY_FROM_EMAIL=
