# ---------------------------------------------------------------------------
# Memory Capture AI — environment variables
# Copy to `.env` for local dev. Never commit real secrets.
# Front-end (Vite) vars must be prefixed VITE_. Everything else is server-only
# (Azure Functions app settings) and must NEVER reach the browser bundle.
# ---------------------------------------------------------------------------

# --- Front-end (safe to expose) ---
# Persistence mode: "guest" (localStorage only, fully offline) or "swa" (profiles
# persist in Cosmos via /api, photos in Blob). Requires the server-only Cosmos +
# Blob connection strings below when set to "swa".
VITE_AUTH_PROVIDER=guest

# Interview engine: "azure" calls the /api Functions (Azure AI Foundry, with
# automatic offline fallback); "offline" forces the local static engine.
# Leave unset for offline; set to azure when the API + keys are configured.
VITE_AI_MODE=azure

# --- Azure AI Foundry / Azure OpenAI (server-only) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Azure AI Speech (server-only) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Persistence (server-only) — Cosmos DB free tier (NoSQL/Core API) ---
COSMOS_CONNECTION_STRING=

# --- Blob storage for storyteller photos (server-only) ---
BLOB_CONNECTION_STRING=
