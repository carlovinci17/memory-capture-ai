{
  "name": "memory-capture-ai-api",
  "version": "0.1.0",
  "private": true,
  "description": "Azure Functions API for Memory Capture AI — Azure AI Foundry orchestration (keys stay server-side).",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
