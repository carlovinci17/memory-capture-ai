    "@azure/storage-blob": "^12.25.0",
    "openai": "^4.67.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "typescript": "^5.5.4",
    "vitest": "^2.1.2"
  }
}
