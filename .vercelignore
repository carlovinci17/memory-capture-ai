# Azure Functions API — exclude Azure-specific files so Vercel doesn't try to
# process them. api/speech/token.ts is a Vercel-native function and is NOT listed
# here so Vercel can deploy it at /api/speech/token.
api/package.json
api/package-lock.json
api/tsconfig.json
api/local.settings.json
api/node_modules/
api/src/
api/dist/
