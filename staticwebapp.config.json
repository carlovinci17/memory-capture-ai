{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/assets/*", "/*.{css,js,png,jpg,svg,ico,woff,woff2}"]
  },
  "routes": [
    { "route": "/login", "rewrite": "/.auth/login/github" },
    { "route": "/logout", "rewrite": "/.auth/logout" },
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/api/profiles", "allowedRoles": ["authenticated"] },
    { "route": "/api/profiles/*", "allowedRoles": ["authenticated"] },
    { "route": "/api/uploads/*", "allowedRoles": ["authenticated"] },
    { "route": "/api/*", "allowedRoles": ["authenticated", "anonymous"] }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
